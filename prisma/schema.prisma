// Pickulator data model
// Postgres via Neon (Vercel Storage integration), accessed through Prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum OccasionType {
  BRUNCH
  LUNCH
  DINNER
  COFFEE
  DRINKS
  LATE
}

enum OccasionDay {
  TODAY
  TOMORROW
  WEEKEND
  OTHER
}

enum OccasionStatus {
  OPEN
  CLOSED
}

enum CloseMode {
  ALL_ANSWERED
  TIME
  MANUAL
}

enum MemberRole {
  HOST
  MEMBER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum TravelMode {
  DRIVE
  TRANSIT
  WALK
  BIKE
}

enum FeedbackChoice {
  WENT
  ELSEWHERE
  DIDNT_GO
}

enum FeedbackRating {
  LOVED
  FINE
  NOT_AGAIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  // Profile.dc.html: dietary needs apply to every round automatically
  dietary      String[] @default([])
  dietaryNotes String?
  travelMode   TravelMode?

  memberships        GroupMember[]
  hostedGroups       Group[]        @relation("GroupHost")
  notifications      Notification[]
  pendingMemberLinks GroupMember[]  @relation("PendingMemberLink")

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  hostUserId String
  host       User   @relation("GroupHost", fields: [hostUserId], references: [id])

  members       GroupMember[]
  occasions     Occasion[]
  customOptions CustomOption[]
}

// A person in a group. May or may not have a User account yet (guest link
// flow — Join.dc.html). userId gets set later via the "claim" step when a
// guest creates an account (Signup.dc.html) without losing their history.
model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  displayName String
  initial     String
  tintColor   String
  role        MemberRole @default(MEMBER)

  // Optional mobile number for text reminders/check-ins (Texts.dc.html)
  phone String?

  // Set when a host invites "by email" for someone without a matching
  // account yet (Invite.dc.html) — resolved once they sign up.
  pendingEmail String?

  // Host-initiated request to move this guest's history onto a registered
  // account (Invite screen's "Link to account"). Doesn't take effect —
  // userId stays null — until that account's owner accepts it themselves
  // (see /api/pending-links). Declining or canceling just clears these.
  pendingLinkUserId String?
  pendingLinkUser   User?     @relation("PendingMemberLink", fields: [pendingLinkUserId], references: [id])
  pendingLinkEmail  String?
  pendingLinkAt     DateTime?

  // The personal link token (…/j/<token>). Resettable by the host; history
  // stays on this same GroupMember row when reset ("Reset link" in
  // Invite.dc.html invalidates the old token but keeps everything else).
  linkToken     String    @unique
  linkCreatedAt DateTime  @default(now())
  linkOpenedAt  DateTime?

  createdAt DateTime @default(now())

  answers       Answer[]
  feedback      Feedback[]
  customOptions CustomOption[]

  @@index([groupId])
}

// One round ("Dinner tonight"). Occasion.dc.html.
model Occasion {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  type     OccasionType
  day      OccasionDay
  timeSlot String
  location String?
  maxDistance  String?
  avoidRepeats Boolean @default(false)

  status    OccasionStatus @default(OPEN)
  closeMode CloseMode      @default(ALL_ANSWERED)
  closeAt   DateTime?

  createdByMemberId String
  createdAt         DateTime  @default(now())
  closedAt          DateTime?

  answers  Answer[]
  result   Result?
  feedback Feedback[]

  @@index([groupId])
}

// One member's hidden answers for a round: Question (ranked picks), Vibe,
// Budget, Dealbreakers, Location. Hidden from the group until everyone answers.
model Answer {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  memberId String
  member   GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  rankedPicks  String[]    @default([]) // ordered option ids, top pick first
  vibe         String?
  budget       String?
  dealbreakers String[]    @default([])
  locationMode TravelMode?

  answeredAt DateTime @default(now())

  @@unique([occasionId, memberId])
}

// A pick option a registered (non-guest) member adds for one round, on
// top of the built-in cuisine list. Visible to everyone in that occasion
// who hasn't answered yet (Question.dc.html "Add your own").
// A permanent addition to a group's rotation of cuisine options (Question
// / Dealbreakers screens), not tied to any single round - once added it
// shows up in every future round until deleted.
model CustomOption {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  label String
  hint  String?

  createdByMemberId String
  createdByMember   GroupMember @relation(fields: [createdByMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([groupId])
}

// The computed pick for a round, once closed. Result.dc.html.
model Result {
  id         String   @id @default(cuid())
  occasionId String   @unique
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  chosenName       String
  chosenMeta       Json // chips, why, travel-time bars, trip notes
  alsoConsidered   Json?
  vetoedByMemberId String?
  vetoedOptionName String?

  createdAt DateTime @default(now())
}

// Post-visit check-in. Feedback.dc.html / Texts.dc.html quick-tap replies.
model Feedback {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  memberId String
  member   GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  choice FeedbackChoice
  rating FeedbackRating?
  notes  String?

  createdAt DateTime @default(now())

  @@unique([occasionId, memberId])
}

// Bell-icon notifications for account holders (guests get texts instead).
// Generic notification inbox (one table for every event type, not one
// table per type). actorUserId/groupId/relatedId are deliberately plain
// strings, not foreign keys - a deleted account or group should never
// corrupt a historical notification row. Created via notifyBestEffort()
// (src/lib/notify.ts), never directly.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String
  title String
  body  String?
  link  String?

  read   Boolean   @default(false)
  readAt DateTime?

  actorUserId String?
  groupId     String?
  relatedId   String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
}

// A standalone social graph between registered accounts, independent of
// any shared group - lets a host quickly add someone to a *new* group
// without retyping their email, and lets people connect before they've
// ever shared a round. Deliberately User-to-User only: a guest who has
// never made an account has no User row in this app (see GroupMember's
// comment), so there's no passwordless "contact" path here the way a
// group invite works - a guest is only ever reachable within the group(s)
// they're already in, and GroupMember.pendingLinkUserId already covers
// turning a known guest into a real connection once they sign up.
//
// Stored as one directional row (requester -> addressee) rather than one
// undirected row per pair, so status can live on the row itself: PENDING
// until the addressee accepts, ACCEPTED once they do. Sending a request
// to someone who already has a PENDING request in to you resolves both
// sides at once instead of leaving two rows (see POST /api/friends).
model Friendship {
  id String @id @default(cuid())

  requesterId String
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  addresseeId String
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Sliding-window-ish request counter for basic abuse throttling (login,
// signup, invite-link lookups - see src/lib/rateLimit.ts). No separate
// Redis/KV service exists for this app, so this trades a small amount of
// Postgres traffic for not adding new infrastructure. Rows are cheap and
// short-lived; rateLimit.ts opportunistically prunes old windows.
model RateLimitHit {
  id          String   @id @default(cuid())
  bucket      String
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@unique([bucket, key, windowStart])
  @@index([bucket, key])
}
